# GROQ_API_KEY: Required for Groq AI API calls.
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="MY_GEMINI_API_KEY"
kelvis=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & Storage configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Google Custom Search API Key and Search Engine ID (GOOGLE_CSE or GOOGLE_CX) for Search Grounding
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CSE=""
GOOGLE_CX=""

# Spotify Web Integration & OAuth credentials
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
